# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thesis_db?schema=public"

# Auth
JWT_SECRET="your-super-secret-key"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Gemini AI (Google AI Studio)
# Obtén tu API key gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
NEXT_PUBLIC_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# MinIO / S3
S3_ENDPOINT="localhost"
S3_PORT=9000
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="thesis-documents"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# ORCID
ORCID_CLIENT_ID="APP-..."
ORCID_CLIENT_SECRET="..."
ORCID_REDIRECT_URI="http://localhost:3001/auth/orcid/callback"

# App
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001"

# SMTP / Email Configuration (Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-correo-gmail@gmail.com"
SMTP_PASS="tu-contrasena-de-aplicacion-gmail"
SMTP_FROM="tu-correo-gmail@gmail.com"

# n8n Webhook Configuration (Soporte Técnico con IA)
# Opcional: Si no se configura, el chat usará respuestas locales
NEXT_PUBLIC_N8N_WEBHOOK_URL="http://localhost:5678/webhook/5196d536-fdf8-40f6-b1d5-10501e4760bd"
N8N_WEBHOOK_URL="http://localhost:5678/webhook/5196d536-fdf8-40f6-b1d5-10501e4760bd"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

